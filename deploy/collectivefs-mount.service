[Unit]
Description=CollectiveFS account mounted at /media/collectivefs
Documentation=https://github.com/physiii/CollectiveFS
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=andy
Group=andy

# CFS_TOKEN is the account. Every machine using the same one sees the same
# files, so it is the only thing that has to match across the fleet.
EnvironmentFile=/etc/collectivefs/mount.env

# Clear any stale endpoint first: on `systemctl restart` the old mount can
# outlive the stop, and then even `mkdir -p` fails with ENOTCONN, taking the
# start down with it. The leading '-' means "nothing mounted" is not an error.
ExecStartPre=-/bin/fusermount3 -u /media/collectivefs
ExecStartPre=/bin/mkdir -p /media/collectivefs
# --token= rather than --token: a URL-safe token may begin with '-', which the
# argument parser would otherwise read as another flag.
ExecStart=/usr/bin/env ${CFS_PYTHON} ${CFS_REPO}/cfs_mount.py /media/collectivefs \
    --api=${CFS_API} \
    --token=${CFS_TOKEN} \
    --allow-other \
    --foreground
ExecStop=/bin/fusermount3 -u /media/collectivefs

Restart=on-failure
RestartSec=5
# A mount that dies mid-write should come back rather than leave a stale handle.
ExecStopPost=/bin/sh -c '/bin/fusermount3 -u /media/collectivefs 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
