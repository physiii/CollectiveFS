# Per-host settings for docker-compose. Copy to .env on each machine.
# .env is gitignored — it also carries provider API keys.

# Host port this node is published on.
CFS_PORT=8010

# How OTHER machines reach this node. Must be an address peers can resolve,
# not localhost: a peer that cannot call back can never return our shards, and
# the node will decline to distribute anything without it.
CFS_OWN_URL=http://192.168.1.40:8010

# Comma-separated peer base URLs to announce to at startup.
CFS_PEER_URLS=http://192.168.1.43:8010

# Agent backend for the section chats: codewhale | claude | codex | builtin
AGENT_PROVIDER=codewhale

# Provider credentials — passed through to the container, never baked in.
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
